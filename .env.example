# Public site URL (canonical, sitemap, OG). No trailing slash.
SITE_URL=https://plots.example.com

# --- Tracking (browser) ---
NEXT_PUBLIC_META_PIXEL_ID=
NEXT_PUBLIC_GA4_ID=
NEXT_PUBLIC_CLARITY_ID=

# --- Meta Conversions API (server) ---
META_CAPI_TOKEN=
# Set while verifying in Events Manager > Test events, then REMOVE before launch.
META_TEST_EVENT_CODE=

# --- Lead storage: Google Sheets via service account ---
GOOGLE_SHEET_ID=
# Raw JSON or base64-encoded JSON of the service account key. Share the sheet with its client_email (Editor).
GOOGLE_SERVICE_ACCOUNT_JSON=
# Optional; defaults to "Leads!A1" (create a tab named Leads).
GOOGLE_SHEET_RANGE=Leads!A1

# --- Notifications ---
# Email via Resend (https://resend.com). Comma-separated recipients.
RESEND_API_KEY=
LEAD_NOTIFY_EMAILS=sales@example.com
LEAD_FROM_EMAIL=Arvind Plots <leads@example.com>

# Optional Telegram alert
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional WhatsApp Cloud API alert (needs an approved template with 1 body variable)
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ALERT_TO=91XXXXXXXXXX
WHATSAPP_ALERT_TEMPLATE=
WHATSAPP_ALERT_LANG=en

# Optional CRM webhook (LeadSquared / Zoho / HubSpot etc.) — receives the lead row as JSON
CRM_WEBHOOK_URL=

# --- Admin dashboard (served on admin.<your-domain>, e.g. admin.localhost:3000 locally) ---
# Postgres connection string (Neon / Supabase / Vercel Postgres). Leave empty locally to use
# the embedded PGlite database in ./.data/pglite. Required on Vercel.
DATABASE_URL=
# 32+ random characters; signs admin session cookies.
SESSION_SECRET=
# First admin, created automatically when the users table is empty. Change the password after first sign-in.
ADMIN_EMAIL=
ADMIN_NAME=
ADMIN_PASSWORD=
